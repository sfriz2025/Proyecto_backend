{
  "info": {
    "name": "Pruebas API Pedidos - E2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear Pedido Exitoso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cuenta_id\": 1,\n    \"platillo_id\": 2,\n    \"modalidad\": \"para llevar\",\n    \"cantidad\": 2\n}"
        },
        "url": {
          "raw": "http://localhost:8000/pedidos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "Listar con Paginación y Filtros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/pedidos?pagina=1&limite=10&direccion=desc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["pedidos"],
          "query": [
            { "key": "pagina", "value": "1" },
            { "key": "limite", "value": "10" },
            { "key": "direccion", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "Error Validación (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cuenta_id\": \"invalido\",\n    \"cantidad\": -5\n}"
        },
        "url": {
          "raw": "http://localhost:8000/pedidos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "Error No Encontrado (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/pedidos/9999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["pedidos"],
          "path": ["pedidos", "9999"]
        }
      }
    }
  ]
}