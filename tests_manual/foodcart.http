@baseUrl = http://127.0.0.1:8000
@cuentaId = 1
@platilloId = 1
@pedidoId = 1

### Listar cuentas
GET {{baseUrl}}/cuentas?pagina=1&limite=10&ordenar_por=id&direccion=asc
Accept: application/json

### Crear cuenta
POST {{baseUrl}}/cuentas
Content-Type: application/json

{
  "nombre_titular": "Cuenta de prueba",
  "correo": "prueba.foodcart@example.cl",
  "presupuesto_mensual": 100000
}

### Obtener cuenta
GET {{baseUrl}}/cuentas/{{cuentaId}}
Accept: application/json

### Ver resumen mensual de cuenta
GET {{baseUrl}}/cuentas/{{cuentaId}}/resumen
Accept: application/json

### Actualizar presupuesto de cuenta
PATCH {{baseUrl}}/cuentas/{{cuentaId}}
Content-Type: application/json

{
  "presupuesto_mensual": 150000
}

### Listar platillos por categoria
GET {{baseUrl}}/platillos?categoria=pastas&pagina=1&limite=10&ordenar_por=nombre&direccion=asc
Accept: application/json

### Crear platillo
POST {{baseUrl}}/platillos
Content-Type: application/json

{
  "nombre": "Sopa de prueba",
  "categoria": "sopas",
  "precio_restaurante": 7000,
  "tiempo_restaurante_min": 15,
  "costo_estimado_casa": 5000,
  "tiempo_casa_min": 40
}

### Obtener platillo precargado
GET {{baseUrl}}/platillos/{{platilloId}}
Accept: application/json

### Actualizar platillo parcialmente
PATCH {{baseUrl}}/platillos/{{platilloId}}
Content-Type: application/json

{
  "precio_restaurante": 12500
}

### Listar productos del platillo
GET {{baseUrl}}/platillos/{{platilloId}}/productos?pagina=1&limite=10&ordenar_por=nombre&direccion=asc
Accept: application/json

### Agregar producto a un platillo
POST {{baseUrl}}/platillos/{{platilloId}}/productos
Content-Type: application/json

{
  "nombre": "Queso rallado",
  "cantidad": 100,
  "unidad": "g",
  "precio_unitario": 4.5
}

### Listar pedidos de una cuenta
GET {{baseUrl}}/pedidos?cuenta_id={{cuentaId}}&pagina=1&limite=10&ordenar_por=fecha&direccion=desc
Accept: application/json

### Crear pedido (cuenta 1 y platillo 1 vienen precargados)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "cuenta_id": 1,
  "platillo_id": 1,
  "modalidad": "restaurante",
  "cantidad": 1
}

### Obtener pedido por ID
GET {{baseUrl}}/pedidos/{{pedidoId}}
Accept: application/json

### Cambiar pedido de pendiente a confirmado
PATCH {{baseUrl}}/pedidos/{{pedidoId}}/estado
Content-Type: application/json

{
  "estado": "confirmado"
}

### Error de validacion esperado (422)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "cuenta_id": 0,
  "platillo_id": 1,
  "modalidad": "presencial",
  "cantidad": 0
}

### Error de recurso inexistente esperado (404)
GET {{baseUrl}}/platillos/999999
Accept: application/json
